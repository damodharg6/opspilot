# Copy to .env and fill in. Never commit .env.

# --- Database -----------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- Shared secrets (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
SHOP_ADMIN_TOKEN=change-me-admin-token
OPSPILOT_API_SECRET=change-me-api-secret

# --- LLM provider (any OpenAI-compatible API) ----------------------------------
# provider: groq | gemini | openai | ollama | custom
OPSPILOT_LLM_PROVIDER=groq
# Check your provider's current model list; names change over time.
OPSPILOT_LLM_MODEL=llama-3.3-70b-versatile
OPSPILOT_LLM_API_KEY=
# Only needed when provider=custom
OPSPILOT_LLM_BASE_URL=

# --- Agent budgets -------------------------------------------------------------
OPSPILOT_AGENT_MAX_TOOL_CALLS=8
OPSPILOT_AGENT_MAX_TOKENS=40000
OPSPILOT_AGENT_TIMEOUT_S=90

# --- Optional: GitHub token for the AWS git backend ----------------------------
GITHUB_TOKEN=
